{
  "expo": {
    "name": "Convex Feedback Routed Expo Demo",
    "slug": "convex-feedback-routed-expo-demo",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "scheme": "convex-feedback-routed",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "ios": {
      "bundleIdentifier": "com.moumentos.convex-feedback-routed-expo-demo"
    },
    "plugins": ["expo-secure-store", "expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
