{
  "name": "convex-feedback-admin-universal",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios --device",
    "ios:dev": "expo prebuild -p ios --clean && expo run:ios --device",
    "web": "expo start --web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib test",
    "export:web": "expo export --platform web --output-dir dist/web",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "export:android": "expo export --platform android --output-dir dist/android",
    "validate": "npm run typecheck && npm run export:web && npm run export:ios && npm run export:android",
    "prebuild:ios": "expo prebuild --no-install --platform ios",
    "prebuild:android": "expo prebuild --no-install --platform android",
    "build:ios:release": "expo run:ios --configuration Release --device generic --no-bundler",
    "build:android:release": "expo run:android --variant release --no-bundler"
  },
  "dependencies": {
    "@clerk/expo": "^4.6.6",
    "@convex-dev/auth": "^0.0.95",
    "@expo/ui": "^57.0.18",
    "@react-native-async-storage/async-storage": "^1.24.0",
    "convex": "^1.45.0",
    "convex-feedback": "^0.2.0",
    "convex-feedback-admin-app-screens": "*",
    "convex-feedback-admin-auth": "*",
    "convex-feedback-ui": "*",
    "expo": "~57.0.22",
    "expo-application": "~57.0.3",
    "expo-auth-session": "~57.0.12",
    "expo-clipboard": "~57.0.2",
    "expo-crypto": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.46.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  }
}
