{
  "name": "convex-feedback-ui",
  "version": "0.1.0",
  "description": "Customizable React and React Native UI primitives for convex-feedback.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "./dist/react/styles.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "default": "./dist/native/index.js"
    },
    "./styles.css": "./dist/react/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:all": "npm run typecheck && npm run lint && npm run test",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "convex-feedback": "^0.1.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-native": "^0.83.0",
    "react-native-safe-area-context": "^4.5.3"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "convex-feedback": "0.1.0",
    "react": "^19.2.0",
    "react-native": "^0.83.10",
    "react-native-safe-area-context": "^4.5.3"
  },
  "types": "./dist/react/index.d.ts",
  "module": "./dist/react/index.js"
}
