{
  "name": "convex-feedback-ui",
  "version": "0.1.5",
  "description": "Customizable React and React Native UI primitives for convex-feedback.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "./dist/react/styles.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./native": {
      "types": "./dist/native/native/index.d.ts",
      "default": "./dist/native/native/index.js"
    },
    "./expo": {
      "types": "./dist/native/expo/index.d.ts",
      "default": "./dist/native/expo/index.js"
    },
    "./styles.css": "./dist/react/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:all": "npm run typecheck && npm run lint && npm run test",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "convex-feedback": "^0.1.4",
    "react": ">=18.2.0",
    "react-native": ">=0.83.0",
    "react-native-safe-area-context": ">=5.4.0",
    "react-native-screens": ">=4.23.0",
    "expo": ">=55.0.0",
    "expo-constants": ">=55.0.0",
    "expo-router": ">=55.0.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-native-screens": {
      "optional": true
    },
    "expo": {
      "optional": true
    },
    "expo-constants": {
      "optional": true
    },
    "expo-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "convex-feedback": "*",
    "react": "^19.2.0",
    "react-native": "^0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "^4.23.0",
    "expo": "^55.0.0",
    "expo-router": "^55.0.18"
  },
  "types": "./dist/react/index.d.ts",
  "module": "./dist/react/index.js"
}
